PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
# Optional: comma-separated DNS servers when the system resolver cannot resolve MongoDB SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8
CLIENT_ORIGIN=http://localhost:5173
